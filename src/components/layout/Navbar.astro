---
import { navItems } from "../../constanst/navigation";
---

<header class="w-full p-6">
  <div class="flex items-center justify-between">
    <h1 class="text-4xl font-semibold tracking-tight">Portfolio</h1>
    <nav class="flex items-center gap-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-lg font-medium px-3 py-1.5 border bg-neutral-100"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
