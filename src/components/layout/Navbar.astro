---
import { navItems } from "../../constanst/navigation";
import Github from "../../assets/Icons/github_light.svg";
import Linkedin from "../../assets/Icons/linkedin.svg";

const contactLink = [
  { href: "https://github.com/Luis0726", icon: Github },
  { href: "", icon: Linkedin } 
]
---

<header class="w-full p-6">
  <div class="flex items-center justify-between">
    <h1 class="text-4xl font-semibold tracking-tight">Portfolio</h1>
    <nav class="flex items-center gap-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-lg font-medium px-2 py-1.5 border rounded-xl"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-4">
      { contactLink.map((link) => (
        <a href={link.href} target="_blank">
          <link.icon width={26} height={26}/>
        </a>
      ))}
    </div>
  </div>
</header>
