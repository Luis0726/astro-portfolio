---
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
---

<section id="proyectos">
  <h2 class="text-3xl font-semibold tracking-tighter">Proyectos</h2>
  <p class="text-xl mt-2">
    Lorem ipsum dolor sit amet consectetur adipisicing elit. Aliquam,
    voluptates.
  </p>
  <div class="flex flex-col items-center gap-2 mt-4">
    {
      allProjects.map((item) => (
        <a
          href={`/projects/${item.id}`}
          class="border p-4 rounded-md bg-neutral-200 w-full block"
        >
          <h3 class="font-mono text-lg font-medium">{item.data.title}</h3>
          <p class="mt-1">{item.data.description}</p>
          <div class="flex items-center gap-2 mt-2">
            {item.data.tags?.map((tag) => (
              <span class="font-semibold">{tag}</span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</section>
