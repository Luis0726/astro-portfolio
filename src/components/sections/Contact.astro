<section id="contacto" class="my-12">
  <h2 class="text-3xl font-semibold tracking-tighter">Contacto</h2>
  <form class="mt-4 flex flex-col gap-3 max-w-xl mx-auto">
    <label class="font-medium" for="name">Nombre</label>
    <input id="name" name="name" type="text" required />

    <label class="font-medium" for="email">Email</label>
    <input id="email" name="email" type="email" required />

    <label class="font-medium" for="message">Mensaje</label>
    <textarea id="message" name="message" rows="4" required></textarea>

    <button type="submit" class="bg-black text-white py-2 rounded-md self-start px-4">
      Enviar
    </button>
  </form>
</section>

<style>
  input,
  textarea {
    border: 1px solid #737373;
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
  }
</style>
